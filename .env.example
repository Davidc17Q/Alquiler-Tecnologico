# Copiar a .env y completar valores antes de docker compose up --build
SECRET_KEY=cambiar-por-clave-segura
DEBUG=True
REDIS_URL=redis://redis:6379/0
# Docker: sqlite:////data/db.sqlite3  |  Local sin Docker: sqlite:///db.sqlite3
DATABASE_URL=sqlite:////data/db.sqlite3
SQLITE_PATH=/data/db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1,django,nginx
SYSTEM_VERSION=1.0.0
PRECIO_USD_DEFAULT=50
EXCHANGE_RATE_TIMEOUT=10
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
